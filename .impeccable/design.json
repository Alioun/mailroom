      "kind": "button",
      "description": "High-contrast amber trigger used when arming session-scoped Live writes.",
      "html": "<button class=\"ds-btn-warning\">Enable live writes</button>",
      "css": ".ds-btn-warning{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:10px 14px;border-radius:6px;border:1px solid #92400e;background:#b45309;color:#fff;font-family:inherit;font-size:12px;font-weight:550;line-height:1.4;cursor:pointer;box-shadow:0 2px 3px #78350f20;transition:background 0.15s,border-color 0.15s}.ds-btn-warning:hover:not(:disabled){background:#92400e;border-color:#78350f}.ds-btn-warning:focus-visible{outline:3px solid #17897b;outline-offset:3px}.ds-btn-warning:disabled{background:var(--disabled-bg,#e9efed);border-color:var(--disabled-border,#cbd7d4);color:var(--disabled-ink,#526663);box-shadow:none;cursor:not-allowed}"
    },
    {
      "name": "Safety Mode Badge",
      "kind": "custom",
      "description": "Topbar pill switching appearance between calm Read-only mode and high-visibility Live writes armed.",
      "html": "<div class=\"ds-safety-row\"><button type=\"button\" class=\"ds-safety-badge\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"/><path d=\"m9 12 2 2 4-4\"/></svg><span>Provider read-only</span></button><button type=\"button\" class=\"ds-safety-badge ds-safety-live\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"/><path d=\"M12 8v4\"/><path d=\"M12 16h.01\"/></svg><span>Live writes armed</span></button></div>",
      "css": ".ds-safety-row{display:flex;gap:10px;flex-wrap:wrap}.ds-safety-badge{display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:6px 12px;border-radius:999px;border:1px solid #c5dbd3;background:#eef7f3;color:#175c4b;font-family:inherit;font-size:12px;font-weight:550;cursor:pointer;transition:background 0.15s,border-color 0.15s,color 0.15s}.ds-safety-badge:hover{background:#e1f1ea;border-color:#9ec5b7}.ds-safety-badge.ds-safety-live{background:#b45309;border-color:#92400e;color:#fff}.ds-safety-badge.ds-safety-live:hover{background:#92400e;border-color:#78350f}.ds-safety-badge:focus-visible{outline:3px solid #17897b;outline-offset:3px}"
    },
