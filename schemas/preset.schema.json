{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preset",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "major": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "renamed": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rule"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "major",
    "rules"
  ],
  "$defs": {
    "Category": {
      "type": "string",
      "enum": [
        "money",
        "contracts",
        "orders",
        "travel",
        "social",
        "newsletters"
      ]
    },
    "Condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "from_address"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "from_domain"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "to_address"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "subject_contains"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "list_id_exists"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "one_click"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "non_bulk"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "attachment"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Rule": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "folder": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "mark_read": {
          "type": "boolean",
          "default": false
        },
        "retain": {
          "type": "boolean",
          "default": false
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "stage",
        "when"
      ]
    },
    "Stage": {
      "type": "string",
      "enum": [
        "guard",
        "from",
        "subject"
      ]
    }
  }
}