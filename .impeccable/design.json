      "html": "<div class=\"ds-notice\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m9 12 2 2 4-4\"/></svg><span>Local rules saved.</span></div>",
      "css": ".ds-notice{border:1px solid #a8d5c5;background:#eef7f2;padding:13px 16px;border-radius:8px;font-size:13px;color:#1c4738;display:flex;align-items:center;gap:10px}.ds-notice-warning{border-color:#e5be6d;background:#fffbeb;color:#713f12}"
    }
  ],
  "narrative": {
    "northStar": "Calm Local-First Operate Workbench",
    "overview": "Mailroom is a local-first **Operate** workbench built with React and Base UI. Users connect personal mail accounts (stored in an encrypted local vault) or explore a clearly labelled synthetic demo account, inspect deduplicated header findings, author and simulate local rules, and only modify real mail after explicitly arming session-scoped Live writes plus per-action preview and confirmation.",
    "keyCharacteristics": [
      "Cool off-white canvas with crisp hairline-bordered panels and calm pine-teal accents",
      "High-visibility amber safety chrome whenever session-scoped Live writes are armed",
      "Unmistakable synthetic demo labeling when exploring invented local mail",
      "Locale-aware EN/DE formatting with tabular numerals and full-width mobile toolbars"
    ],
    "rules": [
      {
        "name": "No Side-Tab Borders",
        "body": "Never use one-sided border-left accent bars on rounded boxes; communicate notice/warning tone through a full tinted border, surface tint, and leading icon.",
        "section": "elevation"
      },
      {
        "name": "Safety Mode Visibility",
        "body": "Read-only uses calm teal; armed Live writes shifts the topbar badge to high-contrast amber and never places a 1-second countdown inside an aria-live region.",
        "section": "colors"
      },
      {
        "name": "Locale & Tabular Numerals",
        "body": "Format all counts, percentages, and dates using en-US or de-DE with tabular-nums and proper singular/plural grammar.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do label synthetic demo sessions in the topbar, sidebar, footer, and unavailable panels.",
      "Do use plain user verbs over protocol acronyms and localize server errors in EN and DE.",
      "Do verify German UI at `390px` width."
    ],
    "donts": [
      "Don't use gradients, cream backgrounds, eyebrow kickers, italic heading accents, section numbers, or border-left side-tabs.",
      "Don't claim \"Encrypted local vault\" in synthetic sessions or enable unavailable actions."
    ]
  }
}
