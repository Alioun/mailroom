  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary action trigger for scanning, saving local rules, and confirming previewed work.",
      "html": "<button class=\"ds-btn-primary\">Check saved rules</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:10px 14px;border-radius:6px;border:1px solid #147466;background:#147466;color:#fff;font-family:inherit;font-size:12px;font-weight:550;line-height:1.4;cursor:pointer;box-shadow:0 2px 3px #113b2820;transition:background 0.15s,border-color 0.15s,box-shadow 0.15s}.ds-btn-primary:hover:not(:disabled){background:#0f6155;border-color:#0f6155}.ds-btn-primary:focus-visible{outline:3px solid #17897b;outline-offset:3px}.ds-btn-primary:disabled{background:var(--disabled-bg,#e9efed);border-color:var(--disabled-border,#cbd7d4);color:var(--disabled-ink,#526663);box-shadow:none;cursor:not-allowed}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "description": "Default neutral control for safe inspections, reloads, and dialog cancellation.",
      "html": "<button class=\"ds-btn-secondary\">Refresh</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:10px 14px;border-radius:6px;border:1px solid #d4dfdc;background:var(--surface,#fff);color:#3e5c55;font-family:inherit;font-size:12px;font-weight:550;line-height:1.4;cursor:pointer;box-shadow:0 1px 2px #162e2310;transition:background 0.15s,border-color 0.15s,box-shadow 0.15s}.ds-btn-secondary:hover:not(:disabled){background:#f5f9f7;border-color:#adc7bd}.ds-btn-secondary:focus-visible{outline:3px solid #17897b;outline-offset:3px}.ds-btn-secondary:disabled{background:var(--disabled-bg,#e9efed);border-color:var(--disabled-border,#cbd7d4);color:var(--disabled-ink,#526663);box-shadow:none;cursor:not-allowed}"
    },
