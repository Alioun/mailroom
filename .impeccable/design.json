      "html": "<div class=\"ds-stat\"><span class=\"ds-stat-label\">Messages</span><strong class=\"ds-stat-value\">1,428</strong><small class=\"ds-stat-detail\">Unique saved messages</small></div>",
      "css": ".ds-stat{border:1px solid var(--border,#d9e3e0);border-radius:9px;background:var(--surface,#fff);padding:20px;display:flex;flex-direction:column;gap:4px;max-width:240px}.ds-stat-label{font-size:12px;color:var(--muted,#526663)}.ds-stat-value{font-size:31px;letter-spacing:-1px;line-height:1.45;font-weight:600;font-variant-numeric:tabular-nums;color:var(--ink,#263c3a)}.ds-stat-detail{font-size:12px;color:var(--muted,#526663)}"
    },
    {
      "name": "Notice Banner",
